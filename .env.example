# Client-side PocketBase URL (PUBLIC_ prefix makes it available to browser via $env/static/public)
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# BoardGameGeek API token. Required by pocketbase/pb_hooks/bgg.pb.js, which proxies BGG's
# XML API2 (search/thing) on the browser's behalf, since BGG now requires
# `Authorization: Bearer <token>` and this token must never ship to the browser. Only
# scripts/dev.sh (and the PocketBase process it starts) reads this - never commit a real
# value here.
BGG_TOKEN=
